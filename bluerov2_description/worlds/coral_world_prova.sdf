<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ocean">

    <scene>
      <grid>false</grid>
    </scene>


    <physics name="10ms" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="water_plane">
      <static>true</static>
      <link name="link">
        <visual name="water_plane">
          <geometry>
            <plane>
              <size>100 100</size>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
          <material>
            <ambient>0 0 1 0.5</ambient>
            <diffuse>0 0 1 0.5</diffuse>
            <specular>0 0 1 0.5</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- MUNDO DE PROVA MISTO, com morros. Gerado por scripts/make_world_prova.py; não edite à mão.
         Fotos (objetos imagem_<id>_...) na zona y<0 (faixas em y = -17.5 a -5.5);
         corais 3D (objetos cad_<id>_...) na zona y>0 (faixas em y = 3.0 a 15.0).
         O mesmo id (P001...) tem a mesma situação e a mesma classe nas duas zonas.
         Verdade de terreno em worlds/prova_manifesto.csv. Precisa de arquivos locais fora do git (ver README). -->
    <include>
      <uri>model://bluerov2_description/models/sand_heightmap</uri>
      <name>seabed</name>
      <pose>0 0 -10.0 0 0 0</pose>
    </include>

    <model name="imagem_P001_s1_controle_branqueado">
      <static>true</static>
      <pose>4.000 -17.500 -9.970 0 0 0.929</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>0.6 0.45</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://bluerov2_description/models/coral_textures_prova/P001.jpg</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
