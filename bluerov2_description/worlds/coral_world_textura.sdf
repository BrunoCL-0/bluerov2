    </model>
    <model name="textura_branqueado_4">
      <static>true</static>
      <pose>7.25 0.00 -9.985 0 0 -0.175</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>0.6 0.6</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://bluerov2_description/models/coral_textures/branqueado_4.png</albedo_map>
              <roughness>0.9</roughness>
