      <pose>3.00 -6.00 -9.985 0 0 0.698</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>0.6 0.6</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://bluerov2_description/models/coral_textures/branqueado_2.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="textura_saudavel_verde_2">
      <static>true</static>
      <pose>4.75 -3.00 -9.959 0 0 0.175</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>0.6 0.6</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://bluerov2_description/models/coral_textures/saudavel_verde_2.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="textura_branqueado_3">
      <static>true</static>
      <pose>4.50 4.50 -9.983 0 0 -0.524</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>0.6 0.45</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://bluerov2_description/models/coral_textures/branqueado_3.jpg</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="textura_saudavel_vermelho_2">
      <static>true</static>
      <pose>5.75 2.50 -9.985 0 0 0.349</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>0.6 0.6</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://bluerov2_description/models/coral_textures/saudavel_vermelho_2.png</albedo_map>
